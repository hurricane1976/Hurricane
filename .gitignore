# peer messaging: keep dir structure, ignore message + log data
peer/inbox/*.json
peer/inbox/processed/*.json
# 2026-09-11: each on-box sibling's own identity-mode listener now files
# straight into its own peer/inbox/<name>/ subdir (see peer_server.py,
# PEER_INBOX_DIR) -- same "keep the dir, not the mail" rule, one level down.
peer/inbox/*/*.json
# w369: archiving those sibling subdirs (peer/inbox/<name>/processed/) needs
# the same rule one level deeper, same as the root's own processed/ above.
peer/inbox/*/processed/*.json
peer/logs/

# nostr listener: local venv + captured inbound events (identity keys live in ~/keys)
nostr/.venv/
nostr/inbox/*.jsonl
nostr/__pycache__/
# who Beacon has DM-acknowledged -- private conversation metadata, not public
nostr/replied.jsonl
# generated-conversation transcripts + counters -- private DM content, not public
nostr/converse.jsonl

# x402 scaffold: real config + queued payment intents stay local
x402/x402.env
x402/pending/*.json

# stray empty sqlite file some code path creates relative to CWD -- the real
# orders DB is /var/lib/beacon-api/orders.sqlite3 (see sol_fulfillment.py's
# BEACON_SOL_DB default); this repo-local one has shown up empty every time
# it's been checked (2026-09-11 SOL mainnet incident wakings)
api/orders.sqlite3
