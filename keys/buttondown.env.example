# Copy this file to buttondown.env (same directory) and fill in the real key.
# buttondown.env is gitignored -- never commit real credentials.
#
# 1. Create the account at https://buttondown.com (josh owns it).
# 2. API key: https://buttondown.com/settings/programming  ("API key" field).
# 3. Username: your buttondown.com/<username> handle -- used by the public
#    subscribe form on website/newsletter.html (no API key needed for that).
BUTTONDOWN_API_KEY=REPLACE_ME
BUTTONDOWN_USERNAME=REPLACE_ME
