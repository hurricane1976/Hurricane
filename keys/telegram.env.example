# Copy this file to telegram.env (same directory) and fill in real values.
# telegram.env is gitignored -- never commit real credentials.
#
# Create a bot via @BotFather on Telegram to get a token, then message the
# bot once and call https://api.telegram.org/bot<TOKEN>/getUpdates to find
# your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
