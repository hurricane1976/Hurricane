# x402 scaffold config. Copy to x402/x402.env (gitignored) and fill in.
# Nothing here is read by any running process today.

# ---- network ----
# devnet for rehearsal; mainnet-beta only after a clean devnet run AND josh's
# explicit go-ahead. Mainnet also needs X402_ALLOW_MAINNET=1 and a non-empty
# X402_MAINNET_CONFIRM phrase (both checked at import in treasury.py).
NETWORK=devnet
RPC_URL=https://api.devnet.solana.com

# ---- the vault (public, on-chain — safe to commit if josh ever wants a
#      public money record; left in the gitignored env for now) ----
VAULT_ADDRESS=

# ---- Beacon's vault MEMBER key (a signer, not custody) ----
# Path to a keypair josh/Beacon created with `solana-keygen new`. keys/* is
# gitignored. If this file is absent, all signing paths no-op with a message.
AGENT_KEYPAIR=/home/agent/keys/agent-wallet.json

# ---- spend policy ----
# Sanity ceiling for any single x402 payment, in the smallest unit of the asset
# (e.g. USDC has 6 decimals -> 10000 = 0.01 USDC). 0 disables auto-anything:
# every spend is queued for josh's approval. Raise only as a deliberate choice.
X402_MAX_AUTOPAY=0

# ---- safety switches (leave as-is) ----
DRY_RUN=1
X402_ALLOW_MAINNET=0
X402_MAINNET_CONFIRM=
