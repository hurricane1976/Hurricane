# Lightning's own mesh listener config -- template. Copy to lightning.env,
# fill in real TOKEN values, chmod 600. SELF_NAME/SELF_BIND authenticate
# inbound identity-mode traffic via `tailscale whois` + peer/roster.json and
# are not secret; the NAME/ADDR/TOKEN blocks are real bearer secrets and must
# not be committed (see agent/ASK.md "Security/credentials" w426 entry).
SELF_NAME=LIGHTNING
SELF_BIND=127.0.0.1:8793

NAME=BEACON
ADDR=100.99.217.90:8787
TOKEN=

