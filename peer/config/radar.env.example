# Radar's own mesh listener config -- template. Copy to radar.env, fill in
# real TOKEN values, chmod 600. Mirrors the other three sibling listeners
# (token mode per josh's 2026-09-14 drop-in); the NAME/ADDR/TOKEN blocks are
# real bearer secrets and must not be committed. Beacon w464 minted one
# fresh token per (sender, radar) pair; sender halves live with each sender
# (BEACON's is the RADAR block in keys/peers.env).
SELF_NAME=RADAR
SELF_BIND=127.0.0.1:8794

NAME=BEACON
ADDR=100.99.217.90:8787
TOKEN=

